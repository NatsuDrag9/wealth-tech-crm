    {
      "id": 5,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "title": "Hybrid Retrieval Latency (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "Retrieval p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "id": 6,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "title": "RAG Synthesis Latency & Synthesis Volume",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_synthesis_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "Synthesis Latency p95",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rag_synthesis_total[1m]))",
          "legendFormat": "Synthesis Rate (req/s)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" }
        }
      }
    },
    {
      "collapsed": false,
