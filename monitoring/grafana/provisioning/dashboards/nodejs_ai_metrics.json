      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "title": "Agent Tool Calls (by Tool & Status)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "sum by (tool_name, status) (rate(agent_tool_calls_total[1m]))",
          "legendFormat": "{{tool_name}} [{{status}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line" }
        }
      }
    },
    {
      "id": 8,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
