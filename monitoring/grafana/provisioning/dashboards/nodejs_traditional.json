      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(s3_operation_duration_seconds_bucket{job=\"backend-nodejs\"}[1m])) by (le, operation))",
          "legendFormat": "{{operation}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
