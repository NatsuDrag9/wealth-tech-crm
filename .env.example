# ==========================================
# Database Credentials
# ==========================================
POSTGRES_DB=wealth_tech_crm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

MONGO_INITDB_DATABASE=wealthtech_crm

# ==========================================
# Security & JWT Keys
# ==========================================
JAVA_JWT_SECRET=your_256_bit_java_jwt_secret_here
NODE_JWT_SECRET=your_nodejs_jwt_secret_here
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ==========================================
# AWS / LocalStack S3 Credentials
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=wealthtech-crm-bucket

## Docker Service Restart Policy
RESTART_POLICY=no
